<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>CB.WPF</RootNamespace>
    <Description>CB.WPF covers a set of WPF controls and extensions that can help to accelerate UI development.</Description>
    <PackageTags>controls colors icons extensions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
