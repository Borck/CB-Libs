<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>CB.System.Net</RootNamespace>
    <Description>CB.System.Net.Pcap monitors network traffic and builds packet capture filters on top of SharpPcap. It needs Npcap (Windows) or libpcap (Linux, macOS) at run time.</Description>
    <PackageTags>network traffic monitor pcap packet capture filter sharppcap</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CB.System.Net\CB.System.Net.csproj" />
    <PackageReference Include="SharpPcap" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
