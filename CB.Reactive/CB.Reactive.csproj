<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>CB.Reactive</RootNamespace>
    <Description>CB.Reactive is a collection of operators and helpers for System.Reactive: scheduler hops that release what they drop, subscriptions that survive a throwing handler, a producer that follows its observers, and more.</Description>
    <PackageTags>reactive rx observable operators scheduler subscription disposable extensions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CB.System\CB.System.csproj" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

</Project>
