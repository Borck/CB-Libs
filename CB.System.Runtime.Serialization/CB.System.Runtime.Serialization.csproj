<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>CB.System.Runtime.Serialization</RootNamespace>
    <Description>CB.System.Runtime.Serialization covers a collection of different implementations of the IFormatter interface.</Description>
    <PackageTags>system formatter serialization protobuf protobuffer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CB.System\CB.System.csproj" />
    <PackageReference Include="protobuf-net" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
