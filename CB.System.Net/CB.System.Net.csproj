<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>CB.System.Net</RootNamespace>
    <Description>CB.System.Net is a collection of networking classes to solve frequently occurring problems: typed TCP clients, reconnect and back-off, address helpers, adapter speed and traffic measurement.</Description>
    <PackageTags>system util helper utility utilities collection network tcp ip mac extensions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CB.System\CB.System.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CB.System.NetTests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
    <!-- SharpPcap is NetMonitor's fallback where the target has no native counter that can filter; net10.0 and later do not reference it. -->
    <PackageReference Include="SharpPcap" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>

</Project>
