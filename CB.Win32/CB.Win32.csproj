<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows;net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>CB.Win32</RootNamespace>
    <Description>CB.Win32 provides a more comfortable way to access the Windows API.</Description>
    <PackageTags>win32 registry icon shortcut process</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Shortcuts and what is built on COM are not part of the netstandard2.0 build. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.core.*</DefaultItemExcludes>
    <DefineConstants>$(DefineConstants);NETSTANDARD2_0</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CB.System\CB.System.csproj" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shortcut is late-bound COM through `dynamic`. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- The registry is in the box on net48; the other targets take it from a package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" />
  </ItemGroup>

</Project>
